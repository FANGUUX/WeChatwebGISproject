/* Create Route Page Styles */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
}

.section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.name-input {
  padding: 20rpx;
  font-size: 30rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
}

/* Transport List */
.transport-list {
  display: flex;
  justify-content: space-between;
}

.transport-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  margin: 0 10rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}

.transport-item:first-child {
  margin-left: 0;
}

.transport-item:last-child {
  margin-right: 0;
}

.transport-item.active {
  border-color: #1aad19;
  background-color: rgba(26, 173, 25, 0.1);
}

.transport-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.transport-name {
  font-size: 26rpx;
  color: #333;
}

/* Tips */
.tips {
  background-color: #e6f7ff;
  border: 1rpx solid #91d5ff;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 40rpx;
}

.tips-title {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: #1890ff;
  margin-bottom: 8rpx;
}

.tips-content {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
}

/* Create Button */
.create-section {
  padding: 20rpx 0;
}

.create-btn {
  background-color: #1aad19;
  color: #fff;
  font-size: 32rpx;
  padding: 24rpx;
  border-radius: 48rpx;
}
