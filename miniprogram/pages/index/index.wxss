/* Index Page Styles */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* Search Bar */
.search-bar {
  padding: 20rpx;
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.search-input {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  padding: 16rpx 24rpx;
  border-radius: 32rpx;
}

.search-icon {
  margin-right: 16rpx;
}

.search-placeholder {
  color: #999;
  font-size: 28rpx;
}

/* Section */
.section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-more {
  font-size: 24rpx;
  color: #1aad19;
}

/* Categories */
.categories {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.category-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.category-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.category-name {
  font-size: 24rpx;
  color: #666;
}

/* Recommendation Cards */
.recommendation-list {
  display: flex;
  overflow-x: auto;
  margin: 0 -24rpx;
  padding: 0 24rpx;
}

.recommendation-card {
  flex-shrink: 0;
  width: 280rpx;
  margin-right: 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.card-image {
  width: 100%;
  height: 180rpx;
}

.card-content {
  padding: 16rpx;
  position: relative;
}

.card-rank {
  position: absolute;
  top: -40rpx;
  left: 16rpx;
  background-color: #ff4d4f;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.card-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-info {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
}

.card-rating {
  color: #faad14;
}

.card-crowd {
  font-size: 20rpx;
}

/* Food Cards */
.food-list {
  display: flex;
  flex-wrap: wrap;
  margin: -10rpx;
}

.food-card {
  width: calc(50% - 20rpx);
  margin: 10rpx;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.food-image {
  width: 100%;
  height: 160rpx;
}

.food-content {
  padding: 12rpx;
}

.food-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.food-cuisine {
  font-size: 20rpx;
  color: #999;
  display: block;
  margin: 4rpx 0;
}

.food-info {
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
}

.food-rating {
  color: #faad14;
}

.food-distance {
  color: #999;
}

/* Empty State */
.empty {
  text-align: center;
  padding: 40rpx;
  color: #999;
}

/* Loading */
.loading {
  text-align: center;
  padding: 40rpx;
  color: #999;
}
