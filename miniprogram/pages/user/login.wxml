<!--
  Login Page
  登录页面
-->
<view class="container">
  <view class="header">
    <image class="logo" src="/assets/logo.png" mode="aspectFit"></image>
    <text class="app-name">智慧旅游</text>
  </view>

  <!-- Login Type Selector -->
  <view class="login-type">
    <radio-group bindchange="onLoginTypeChange">
      <label class="type-option {{loginType === 'wechat' ? 'active' : ''}}">
        <radio value="wechat" checked="{{loginType === 'wechat'}}" />
        微信登录
      </label>
      <label class="type-option {{loginType === 'phone' ? 'active' : ''}}">
        <radio value="phone" checked="{{loginType === 'phone'}}" />
        手机登录
      </label>
    </radio-group>
  </view>

  <!-- WeChat Login -->
  <view class="wechat-login" wx:if="{{loginType === 'wechat'}}">
    <button class="wechat-btn" bindtap="onWechatLogin">
      <text class="wechat-icon">💬</text>
      微信一键登录
    </button>
    <text class="wechat-tip">使用微信账号快速登录</text>
  </view>

  <!-- Phone Login -->
  <view class="phone-login" wx:else>
    <view class="form-group">
      <text class="form-label">手机号</text>
      <input 
        class="form-input" 
        type="number" 
        maxlength="11"
        placeholder="请输入手机号"
        value="{{phone}}"
        bindinput="onPhoneInput"
      />
    </view>

    <view class="form-group">
      <text class="form-label">密码</text>
      <input 
        class="form-input" 
        type="text" 
        password="true"
        placeholder="请输入密码"
        value="{{password}}"
        bindinput="onPasswordInput"
      />
    </view>

    <button class="phone-btn" bindtap="onPhoneLogin">
      {{isRegister ? '注册' : '登录'}}
    </button>

    <view class="toggle-mode" bindtap="toggleMode">
      <text>{{isRegister ? '已有账号？立即登录' : '没有账号？立即注册'}}</text>
    </view>
  </view>

  <view class="agreement">
    <text>登录即表示同意</text>
    <text class="link">《用户协议》</text>
    <text>和</text>
    <text class="link">《隐私政策》</text>
  </view>
</view>
