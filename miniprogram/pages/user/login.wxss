/* Login Page Styles */
.container {
  min-height: 100vh;
  padding: 60rpx 40rpx;
  background-color: #fff;
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 20rpx;
}

.app-name {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #1aad19;
}

/* Login Type */
.login-type {
  margin-bottom: 40rpx;
}

.login-type radio-group {
  display: flex;
  justify-content: center;
}

.type-option {
  padding: 16rpx 32rpx;
  margin: 0 20rpx;
  font-size: 28rpx;
  color: #666;
  border-radius: 32rpx;
  background-color: #f5f5f5;
}

.type-option.active {
  color: #1aad19;
  background-color: rgba(26, 173, 25, 0.1);
}

.type-option radio {
  display: none;
}

/* WeChat Login */
.wechat-login {
  text-align: center;
  padding: 60rpx 0;
}

.wechat-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #1aad19;
  color: #fff;
  font-size: 32rpx;
  padding: 24rpx 0;
  border-radius: 48rpx;
}

.wechat-icon {
  margin-right: 16rpx;
  font-size: 40rpx;
}

.wechat-tip {
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #999;
}

/* Phone Login */
.phone-login {
  padding: 40rpx 0;
}

.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  padding: 24rpx;
  font-size: 30rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.phone-btn {
  margin-top: 40rpx;
  background-color: #1aad19;
  color: #fff;
  font-size: 32rpx;
  padding: 24rpx 0;
  border-radius: 48rpx;
}

.toggle-mode {
  text-align: center;
  margin-top: 30rpx;
}

.toggle-mode text {
  font-size: 26rpx;
  color: #1aad19;
}

/* Agreement */
.agreement {
  position: fixed;
  bottom: 60rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 22rpx;
  color: #999;
}

.agreement .link {
  color: #1aad19;
}
