/* Food Discovery Page Styles */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* Mode Header */
.mode-header {
  padding: 24rpx 32rpx;
  background-color: #ff6b35;
  color: #fff;
  text-align: center;
}

.mode-title {
  font-size: 32rpx;
  font-weight: bold;
}

/* Search Bar */
.search-bar {
  display: flex;
  padding: 20rpx;
  background-color: #fff;
}

.search-input {
  flex: 1;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  background-color: #f5f5f5;
  border-radius: 32rpx;
}

.search-btn {
  padding: 16rpx 32rpx;
  margin-left: 20rpx;
  font-size: 28rpx;
  color: #fff;
  background-color: #ff6b35;
  border-radius: 32rpx;
}

/* Cuisines */
.cuisines-scroll {
  background-color: #fff;
  white-space: nowrap;
  padding: 0 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.cuisines {
  display: inline-flex;
  padding: 16rpx 0;
}

.cuisine-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 12rpx;
}

.cuisine-item.active {
  background-color: rgba(255, 107, 53, 0.1);
}

.cuisine-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

.cuisine-name {
  font-size: 24rpx;
  color: #666;
}

.cuisine-item.active .cuisine-name {
  color: #ff6b35;
  font-weight: bold;
}

/* Restaurant List */
.restaurant-list {
  padding: 20rpx;
}

.restaurant-card {
  display: flex;
  position: relative;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.restaurant-image {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
}

.restaurant-content {
  flex: 1;
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.restaurant-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.restaurant-meta {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.restaurant-cuisine {
  font-size: 22rpx;
  color: #ff6b35;
  padding: 4rpx 12rpx;
  background-color: rgba(255, 107, 53, 0.1);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.restaurant-price {
  font-size: 24rpx;
  color: #666;
}

.restaurant-info {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.restaurant-rating {
  font-size: 24rpx;
  color: #faad14;
  margin-right: 20rpx;
}

.restaurant-distance {
  font-size: 22rpx;
  color: #999;
}

.restaurant-features {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.feature {
  font-size: 20rpx;
  color: #999;
  margin-right: 16rpx;
}

/* Add to Route Button */
.add-button {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 12rpx 24rpx;
  background-color: #ff6b35;
  color: #fff;
  font-size: 24rpx;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 53, 0.3);
  z-index: 10;
}

/* Empty State */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
}

/* Loading */
.loading {
  text-align: center;
  padding: 40rpx;
  color: #999;
}
