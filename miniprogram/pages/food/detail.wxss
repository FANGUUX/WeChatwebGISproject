/* Food Detail Page Styles */
.container {
  padding-bottom: 140rpx;
  background-color: #f5f5f5;
}

/* Cover Swiper */
.cover-swiper {
  height: 400rpx;
}

.cover-image {
  width: 100%;
  height: 100%;
}

/* Info Section */
.info-section {
  background-color: #fff;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.restaurant-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.rating {
  display: flex;
  align-items: center;
}

.rating-star {
  font-size: 28rpx;
}

.rating-value {
  font-size: 28rpx;
  color: #faad14;
  font-weight: bold;
  margin: 0 8rpx;
}

.rating-count {
  font-size: 22rpx;
  color: #999;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.tag {
  font-size: 22rpx;
  color: #666;
  background-color: #f5f5f5;
  padding: 6rpx 16rpx;
  border-radius: 4rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.tag.cuisine {
  color: #ff6b35;
  background-color: rgba(255, 107, 53, 0.1);
}

.location {
  display: flex;
  align-items: center;
}

.location-icon {
  margin-right: 8rpx;
}

.location-text {
  font-size: 26rpx;
  color: #666;
}

/* Detail Section */
.detail-section {
  background-color: #fff;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-label {
  font-size: 28rpx;
  color: #666;
}

.detail-value {
  font-size: 28rpx;
  color: #333;
}

.detail-value.price {
  color: #ff6b35;
  font-weight: bold;
  font-size: 32rpx;
}

/* Features Section */
.features-section {
  background-color: #fff;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.features-list {
  display: flex;
  flex-wrap: wrap;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 25%;
  padding: 16rpx;
  opacity: 0.4;
}

.feature-item.active {
  opacity: 1;
}

.feature-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.feature-name {
  font-size: 22rpx;
  color: #666;
}

/* Description Section */
.desc-section {
  background-color: #fff;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.description {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

/* Bottom Actions */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx;
  background-color: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.action-btn.secondary {
  background-color: #f5f5f5;
  color: #666;
}

.action-btn.primary {
  flex: 1;
  background-color: #ff6b35;
  color: #fff;
  font-size: 30rpx;
  margin-right: 0;
}

.btn-icon {
  font-size: 32rpx;
  margin-bottom: 4rpx;
}

/* Loading */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  color: #999;
}
