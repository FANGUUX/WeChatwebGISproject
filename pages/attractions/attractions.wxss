/* pages/attractions/attractions.wxss - 景点列表样式 */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

/* 搜索栏 */
.search-bar {
  padding: 20rpx 24rpx;
  background-color: #fff;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.clear-btn {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #ccc;
  border-radius: 50%;
  color: #fff;
  font-size: 28rpx;
}

/* 分类筛选 */
.category-scroll {
  white-space: nowrap;
  background-color: #fff;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #eee;
}

.category-item {
  display: inline-block;
  padding: 12rpx 32rpx;
  margin-right: 16rpx;
  font-size: 28rpx;
  color: #666;
  background-color: #f5f5f5;
  border-radius: 30rpx;
}

.category-item.active {
  color: #fff;
  background-color: #07c160;
}

/* 排序栏 */
.sort-bar {
  display: flex;
  background-color: #fff;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #eee;
}

.sort-item {
  margin-right: 40rpx;
  font-size: 28rpx;
  color: #666;
  display: flex;
  align-items: center;
}

.sort-item.active {
  color: #07c160;
}

.sort-arrow {
  margin-left: 4rpx;
}

/* 景点列表 */
.attraction-list {
  flex: 1;
  padding: 20rpx;
}

.list-item {
  display: flex;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.item-image {
  position: relative;
  width: 240rpx;
  min-width: 240rpx;
}

.item-img {
  width: 100%;
  height: 100%;
  min-height: 320rpx;
}

.item-category {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background-color: rgba(7, 193, 96, 0.9);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.item-content {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.item-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.item-rating {
  display: flex;
  align-items: center;
}

.star {
  color: #ffc107;
  font-size: 28rpx;
  margin-right: 4rpx;
}

.rating-value {
  font-size: 28rpx;
  color: #666;
}

.item-address {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.address-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
}

.address-text {
  font-size: 24rpx;
  color: #666;
}

.item-info {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.info-item {
  display: flex;
  align-items: center;
  margin-right: 20rpx;
}

.info-icon {
  font-size: 22rpx;
  margin-right: 4rpx;
}

.info-text {
  font-size: 22rpx;
  color: #999;
}

.item-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  white-space: normal;
}

.item-actions {
  display: flex;
  gap: 16rpx;
  margin-top: auto;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.detail-btn {
  background-color: #f0f0f0;
  color: #666;
}

.route-btn {
  background-color: #e6f7ff;
  color: #1890ff;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
