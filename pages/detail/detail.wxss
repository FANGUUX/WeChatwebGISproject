/* pages/detail/detail.wxss - 景点详情样式 */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

/* 头部图片 */
.header-image {
  position: relative;
  width: 100%;
  height: 400rpx;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.header-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
  padding: 40rpx 24rpx 24rpx;
}

.header-content {
  color: #fff;
}

.attraction-name {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.attraction-category {
  display: inline-block;
  font-size: 24rpx;
  background-color: rgba(255, 255, 255, 0.3);
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
}

.back-btn {
  position: absolute;
  top: 80rpx;
  left: 24rpx;
  width: 60rpx;
  height: 60rpx;
  background-color: rgba(0, 0, 0, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 36rpx;
}

/* 内容滚动区 */
.content-scroll {
  flex: 1;
}

/* 信息卡片 */
.info-card {
  background-color: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.card-header {
  display: flex;
  justify-content: flex-start;
  margin-bottom: 24rpx;
}

.rating-box {
  display: flex;
  align-items: center;
  background-color: #fff8e6;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
}

.rating-star {
  color: #ffc107;
  font-size: 32rpx;
  margin-right: 8rpx;
}

.rating-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff9800;
  margin-right: 8rpx;
}

.rating-label {
  font-size: 24rpx;
  color: #999;
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.info-item {
  display: flex;
  align-items: flex-start;
}

.info-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
  margin-top: 4rpx;
}

.info-content {
  flex: 1;
}

.info-label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 4rpx;
}

.info-value {
  font-size: 28rpx;
  color: #333;
}

/* 景点介绍 */
.desc-card {
  background-color: #fff;
  margin: 0 20rpx 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #07c160;
}

.desc-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  text-align: justify;
}

/* 位置地图 */
.map-card {
  background-color: #fff;
  margin: 0 20rpx 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.detail-map {
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
}

/* 推荐景点 */
.recommend-card {
  background-color: #fff;
  margin: 0 20rpx 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.recommend-scroll {
  white-space: nowrap;
}

.recommend-item {
  display: inline-block;
  width: 200rpx;
  margin-right: 20rpx;
  vertical-align: top;
}

.recommend-item:last-child {
  margin-right: 0;
}

.recommend-img {
  width: 200rpx;
  height: 140rpx;
  border-radius: 12rpx;
}

.recommend-name {
  font-size: 26rpx;
  color: #333;
  margin-top: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommend-rating {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

.recommend-rating .star {
  color: #ffc107;
  margin-right: 4rpx;
}

.bottom-placeholder {
  height: 140rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background-color: #fff;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.bar-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
}

.btn-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

.btn-text {
  font-size: 22rpx;
  color: #666;
}

.primary-btn {
  background-color: #07c160;
  border-radius: 8rpx;
  margin: 0 8rpx;
}

.primary-btn .btn-text {
  color: #fff;
}

.navigate-btn {
  background-color: #1890ff;
  border-radius: 8rpx;
}

.navigate-btn .btn-text {
  color: #fff;
}
